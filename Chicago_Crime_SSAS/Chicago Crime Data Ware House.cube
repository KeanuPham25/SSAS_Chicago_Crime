  <Source dwd:design-time-name="06debdbb-0d0f-4803-8805-49fabaa499ee">
    <DataSourceViewID>Chicago Crime Data Ware House</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="25b886cf-fe2d-48d6-83eb-ba3c19487236">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].[Arrest Rate]
 AS IIF([Measures].[FACT CRIMES Count] = 0, NULL, [Measures].[Arrest Count] / [Measures].[FACT CRIMES Count]), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT CRIMES';  
CREATE MEMBER CURRENTCUBE.[Measures].[Domestic Arrest Rate]
 AS IIF([Measures].[Domestic Count] = 0, NULL,
    [Measures].[Domestic Arrest Count] / [Measures].[Domestic Count]), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[YoY Growth]
 AS IIF([DIM DATE].[YEAR].CurrentMember.Level.Ordinal = 0
    OR IsEmpty(([Measures].[FACT CRIMES Count], [DIM DATE].[YEAR].CurrentMember.PrevMember))
    OR ([Measures].[FACT CRIMES Count], [DIM DATE].[YEAR].CurrentMember.PrevMember) = 0,
    NULL,
    [Measures].[FACT CRIMES Count] /
    ([Measures].[FACT CRIMES Count], [DIM DATE].[YEAR].CurrentMember.PrevMember) - 1), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Time Period Share]
 AS IIF(
    ([Measures].[FACT CRIMES Count], [DIM HOUR].[TIME PERIOD].DefaultMember) = 0,
    NULL,
    [Measures].[FACT CRIMES Count] /
    ([Measures].[FACT CRIMES Count], [DIM HOUR].[TIME PERIOD].DefaultMember)
), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT CRIMES';  
CREATE MEMBER CURRENTCUBE.[Measures].[Theft Count]
 AS ([Measures].[FACT CRIMES Count], [DIM CRIME TYPE].[PRIMARY TYPE].&amp;[THEFT]), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT CRIMES';  
CREATE MEMBER CURRENTCUBE.[Measures].[Theft Share]
 AS IIF([Measures].[FACT CRIMES Count] = 0, NULL,
    [Measures].[Theft Count] / [Measures].[FACT CRIMES Count]), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT CRIMES';  
CREATE MEMBER CURRENTCUBE.[Measures].[Theft Arrest Rate]
 AS IIF([Measures].[Theft Count] = 0, NULL,
    ([Measures].[Arrest Count], [DIM CRIME TYPE].[PRIMARY TYPE].&amp;[THEFT])
    / [Measures].[Theft Count]), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT CRIMES';  
CREATE MEMBER CURRENTCUBE.[Measures].[Theft QoQ Growth]
 AS IIF(IsEmpty(([Measures].[Theft Count], [DIM DATE].[QUARTER].CurrentMember.PrevMember))
    OR ([Measures].[Theft Count], [DIM DATE].[QUARTER].CurrentMember.PrevMember) = 0,
    NULL,
    [Measures].[Theft Count] /
    ([Measures].[Theft Count], [DIM DATE].[QUARTER].CurrentMember.PrevMember) - 1), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT CRIMES';  
CREATE MEMBER CURRENTCUBE.[Measures].[Area Total Crimes]
 AS ([Measures].[FACT CRIMES Count], [DIM CRIME TYPE].[PRIMARY TYPE].DefaultMember), 
FORMAT_STRING = "#,#", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT CRIMES';  
CREATE MEMBER CURRENTCUBE.[Measures].[Share In Area]
 AS IIF(
    [Measures].[Area Total Crimes] = 0,
    NULL,
    [Measures].[FACT CRIMES Count] / [Measures].[Area Total Crimes]
), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'FACT CRIMES'; 
CREATE MEMBER CURRENTCUBE.[Measures].[Non-Domestic Count]
 AS [Measures].[FACT CRIMES Count] - [Measures].[Domestic Count], 
FORMAT_STRING = "#,#", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Non-Domestic Arrest Count]
 AS [Measures].[Arrest Count] - [Measures].[Domestic Arrest Count], 
FORMAT_STRING = "#,#", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Non-Domestic Arrest Rate]
 AS IIF(
  [Measures].[Non-Domestic Count] = 0,
  NULL,
  [Measures].[Non-Domestic Arrest Count] / [Measures].[Non-Domestic Count]
), 
FORMAT_STRING = "#,#", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Arrest Rate Gap]
 AS IIF(
  IsEmpty([Measures].[Domestic Arrest Rate])
  OR IsEmpty([Measures].[Non-Domestic Arrest Rate]),
  NULL,
  [Measures].[Domestic Arrest Rate] - [Measures].[Non-Domestic Arrest Rate]
), 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>